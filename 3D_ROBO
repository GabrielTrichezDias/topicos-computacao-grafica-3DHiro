<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">

  <script src="https://aframe.io/releases/1.6.0/aframe.min.js"></script>
  <script src="https://raw.githack.com/AR-js-org/AR.js/master/aframe/build/aframe-ar.js"></script>

  <script>
    AFRAME.registerComponent('tocar-animacao', {
      init: function () {
        this.el.addEventListener('model-loaded', (e) => {
          const model = e.detail.model;

          if (model.animations && model.animations.length > 0) {
            this.mixer = new THREE.AnimationMixer(model);
            this.mixer.clipAction(model.animations[0]).play();
          }
        });
      },

      tick: function (t, dt) {
        if (this.mixer) this.mixer.update(dt / 1000);
      }
    });
  </script>
</head>

<body style="margin: 0; overflow: hidden;">

  <a-scene embedded arjs="sourceType: webcam; debugUIEnabled: false;" vr-mode-ui="enabled: false">

    <!-- MODELOS -->
    <a-assets>
      <a-asset-item id="astronauta" src="modelos/astronauta/astronauta.glb"></a-asset-item>
      <a-asset-item id="robo" src="modelos/robo/robo.glb"></a-asset-item>
    </a-assets>

    <!-- MARCADOR HIRO -->
    <a-marker preset="hiro">

      <a-entity position="0 0.5 0">

        <!-- PLANETA -->
        <a-sphere
          radius="0.4"
          color="#4fd1c5"
          animation="property: rotation; to: 0 360 0; loop: true; dur: 8000; easing: linear">
        </a-sphere>

        <!-- TEXTO -->
        <a-text
          value="Planeta"
          align="center"
          position="0 1 0"
          color="#ffffff"
          width="4">
        </a-text>

        <!-- LUA -->
        <a-entity animation="property: rotation; to: 0 360 0; loop: true; dur: 4000; easing: linear">
          <a-sphere radius="0.1" color="#ffb454" position="0.8 0 0"></a-sphere>
        </a-entity>

        <!-- ASTRONAUTA -->
        <a-entity
          gltf-model="#astronauta"
          position="-0.8 0.2 0"
          rotation="0 90 0"
          scale="2.35 2.35 2.35">
        </a-entity>

        <!-- ROBO -->
        <a-entity
          gltf-model="#robo"
          tocar-animacao
          position="0.8 0.2 0"
          rotation="0 -90 0"
          scale="2.35 2.35 2.35">
        </a-entity>

      </a-entity>

    </a-marker>

    <a-entity camera></a-entity>

  </a-scene>

</body>
</html>
